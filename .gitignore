# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 개인정보 — 상담·체크 응답은 절대 커밋하지 않는다.
# 한 번 히스토리에 들어가면 되돌릴 수 없다.
/data/submissions/
/data/submissions.json
*.submissions.json
/data/leads.jsonl
/data/checks.jsonl
/data/check-purge-log.jsonl
/data/*.jsonl

# 관리자가 업로드한 이미지 (저장소가 아니라 오브젝트 스토리지로 가야 한다)
/public/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
